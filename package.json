{
  "name": "etag-desktop",
  "version": "1.0.0",
  "description": "اتاج للمحاسبات - برنامج سطح المكتب",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "Abdalslam",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.etag.accounting",
    "productName": "EtajAccounting",
    "publish": [
      {
        "provider": "github",
        "owner": "abdalslamcopp6-source",
        "repo": "etag-desktop"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "aegoonh.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "background.png",
      "aegoonh.png"
    ]
  }
}
